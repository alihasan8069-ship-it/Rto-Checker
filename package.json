{
  "name": "rto-return-scanner",
  "version": "22.0.0",
  "description": "Offline RTO & Customer Return Scanner desktop app",
  "main": "electron/main.js",
  "author": "RTO Return Scanner",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.rto.returnscanner",
    "productName": "RTO Return Scanner",
    "directories": { "output": "dist" },
    "files": ["index.html", "style.css", "app.js", "README.md", "electron/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
